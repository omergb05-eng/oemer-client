{
  "rules": {
    ".read": false,
    ".write": false,

    "usernames": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && $name.matches(/^[a-z0-9_]{3,16}$/) && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "newData.isString() && newData.val().length <= 40"
      }
    },

    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name'])",
        "name": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_]{3,16}$/)" },
        "mc": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "seen": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "skins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friends').child($uid).child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid",
        "cape": { ".validate": "newData.isString() && newData.val().length <= 60000" },
        "totem": { ".validate": "newData.isString() && newData.val().length <= 120000" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "logo": { ".validate": "newData.isString() && newData.val().length <= 9000" },
        "$other": { ".validate": false }
      }
    },

    "requests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && ((auth.uid === $from && $to !== $from && newData.exists()) || (!newData.exists() && (auth.uid === $to || auth.uid === $from)))",
          ".validate": "newData.hasChildren(['name', 'ts']) && newData.child('name').isString() && newData.child('name').val().length <= 16",
          "name": { ".validate": true },
          "ts": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "friends": {
      "$a": {
        ".read": "auth != null && auth.uid === $a",
        "$b": {
          ".write": "auth != null && (auth.uid === $a || auth.uid === $b) && (!newData.exists() || (newData.val() === true && root.child('requests').child(auth.uid).child(auth.uid === $a ? $b : $a).exists()))",
          ".validate": "newData.val() === true"
        }
      }
    },

    "sharing": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$friend": { ".validate": "newData.isBoolean()" }
      }
    },

    "listenAllow": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friend": {
          ".read": "auth != null && auth.uid === $friend",
          ".write": "auth != null && auth.uid === $uid && root.child('friends').child($uid).child($friend).val() === true",
          ".validate": "newData.isBoolean()"
        }
      }
    },

    "listening": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('friends').child($uid).child(auth.uid).val() === true && root.child('sharing').child($uid).child(auth.uid).val() !== false))",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.hasChildren(['id', 'at'])",
        "id": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "title": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "artist": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "service": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "pos": { ".validate": "newData.isNumber()" },
        "at": { ".validate": "newData.isNumber()" },
        "playing": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },

    "messages": {
      "$a": {
        ".read": "auth != null && auth.uid === $a",
        "$b": {
          ".indexOn": ["ts"],
          "$id": {
            ".write": "auth != null && ((!newData.exists() && auth.uid === $a) || (!data.exists() && newData.exists() && (auth.uid === $a || auth.uid === $b) && root.child('friends').child($a).child($b).val() === true))",
            ".validate": "newData.hasChildren(['from', 'text', 'ts']) && newData.child('from').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 300 && newData.child('ts').isNumber()",
            "from": { ".validate": true },
            "text": { ".validate": true },
            "ts": { ".validate": true },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "inbox": {
      "$a": {
        ".read": "auth != null && auth.uid === $a",
        "$b": {
          ".write": "auth != null && ((!newData.exists() && auth.uid === $a) || (newData.exists() && (auth.uid === $a || auth.uid === $b) && root.child('friends').child($a).child($b).val() === true))",
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}
